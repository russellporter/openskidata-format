{
  "name": "openskidata-format",
  "version": "15.0.0",
  "description": "Data format for OpenSkiMap.org",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "rm -rf dist/ && tsc",
    "prepare": "npm run build",
    "release": "npm run build && npm publish",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-types": "tsc --project tsconfig.typecheck.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/russellporter/openskidata-format.git"
  },
  "author": "Russell Porter",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/russellporter/openskidata-format/issues"
  },
  "homepage": "https://github.com/russellporter/openskidata-format#readme",
  "dependencies": {
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "@turf/center": "^7.4.0",
    "@turf/distance": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "@turf/length": "^7.4.0",
    "@turf/line-chunk": "^7.4.0",
    "@types/geojson": "^7946.0.16"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
